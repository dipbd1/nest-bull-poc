JOB_QUEUE_NAME=jobs
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false
PORT=3000

# Production (NODE_ENV=production) refuses to start until WEB_ORIGIN, a
# non-default JWT_SECRET, DATABASE_URL, REDIS_HOST, and the key for
# AI_DEFAULT_PROVIDER are set. It also turns off schema synchronize and runs
# the committed migrations instead.
NODE_ENV=
# The one browser origin allowed to call the API. Development default:
# http://localhost:5173.
WEB_ORIGIN=

# Local-dev switch. Ignored when NODE_ENV=production.
ALLOW_PUBLIC_REGISTER=false
# Creates the first admin when the user table is empty. Remove both after the
# first sign-in and change that password.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Optional company login (OpenID Connect). Set all three to show "Continue with
# company login". Register ${WEB_ORIGIN}/api/auth/oidc/callback as the redirect
# URI at the provider. People still need an invite or an existing account.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Worker throttle for model calls. Concurrency stays 1.
MODEL_REQUESTS_PER_MINUTE=20

# Lakebase Postgres on Neon. `neon deploy` writes the pooled URL to ../.env.local.
DATABASE_URL=

JWT_SECRET=dev-jwt-secret
JWT_EXPIRES_IN=1d

SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=noreply@localhost
EMAIL_VERIFICATION_REQUIRED=true

AI_DEFAULT_PROVIDER=openai
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=2

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_BASE_URL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_BASE_URL=

GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_BASE_URL=

OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_EMBEDDING_MODEL=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_NAME=openai-compatible

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBEDDING_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=
